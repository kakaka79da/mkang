<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiemployee</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPLACE_WITH_FULL_PATH/start.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>REPLACE_WITH_FULL_PATH/logs/launchd_out.log</string>

    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_FULL_PATH/logs/launchd_err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/sbin</string>
        <key>HOME</key>
        <string>REPLACE_WITH_HOME</string>
        <key>DYLD_LIBRARY_PATH</key>
        <string>REPLACE_WITH_HOME/llama.cpp/build/bin:/usr/local/lib</string>
    </dict>
</dict>
</plist>
